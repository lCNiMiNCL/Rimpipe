<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Dev 验收建筑。不进建造栏。 -->

  <ThingDef ParentName="BuildingBase">
    <defName>RimPipe_Dev_Tank</defName>
    <label>rimpipe 测试储罐</label>
    <description>验收用储罐。四面端口；管道铺在端口邻格。</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_MenuIcon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/Linked/PowerConduit_MenuIcon</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>10</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>1</Steel>
    </costList>
    <building>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="RimPipe.CompProperties_PipeNetworkMember">
        <defaultMaxFlowRate>10</defaultMaxFlowRate>
        <!-- Amb-A：Dev 罐无保温，与产品储罐 0.7 对比 -->
        <insulation>0</insulation>
        <maxAmbientHeatRate>10</maxAmbientHeatRate>
        <containers>
          <li>
            <capacity>100</capacity>
            <fluidDefName>RimPipe_Fluid_TestWater</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
        </containers>
        <!-- 四向本地边：管道必须落在端口「外一格」才会建 Mapping -->
        <ports>
          <li>
            <localRot>North</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>South</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>West</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>East</localRot>
            <containerIndex>0</containerIndex>
          </li>
        </ports>
      </li>
      <li Class="RimPipe.CompProperties_PipeBreachable" />
    </comps>
    <!-- 不进建造菜单；仅 Debug / DefOf 回归用 -->
    <uiOrder>1000</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

