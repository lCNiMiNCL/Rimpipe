  <!-- 化学验收：三腔反应釜（西=液氧 东=煤油 北=排气）。不进建造栏。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>RimPipe_Dev_Reactor</defName>
    <label>rimpipe 测试反应釜</label>
    <description>化学验收用三腔反应釜（液氧+航天煤油→排气）。需开关与电力；不进建造栏。</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Misc/MoisturePump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/Misc/MoisturePump</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>10</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>1</Steel>
    </costList>
    <building>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="RimPipe.CompProperties_PipeNetworkMember">
        <defaultMaxFlowRate>10</defaultMaxFlowRate>
        <insulation>0.5</insulation>
        <containers>
          <li>
            <capacity>100</capacity>
            <fluidDefName>RimPipe_Fluid_LOX</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
          <li>
            <capacity>100</capacity>
            <fluidDefName>RimPipe_Fluid_RP1</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
          <li>
            <capacity>100</capacity>
            <fluidDefName>RimPipe_Fluid_TestExhaust</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
        </containers>
        <ports>
          <li>
            <localRot>West</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>East</localRot>
            <containerIndex>1</containerIndex>
          </li>
          <li>
            <localRot>North</localRot>
            <containerIndex>2</containerIndex>
          </li>
        </ports>
      </li>
      <li Class="RimPipe.CompProperties_PipeReactor">
        <reactionDefName>RimPipe_Reaction_LoxRp1</reactionDefName>
        <inputContainerIndices>
          <li>0</li>
          <li>1</li>
        </inputContainerIndices>
        <outputContainerIndices>
          <li>2</li>
        </outputContainerIndices>
      </li>
      <li Class="RimPipe.CompProperties_PipeBreachable" />
    </comps>
    <placeWorkers>
      <li>RimPipe.PlaceWorker_RimPipeAppliance</li>
    </placeWorkers>
    <uiOrder>1040</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>


