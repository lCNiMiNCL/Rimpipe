<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 产品建筑。贴图暂借：蓄电池 / 抽湿机 / 电缆 / 电力开关。Dev 不进建造栏。 -->

  <ThingDef ParentName="BuildingBase">
    <defName>RimPipe_StorageTank</defName>
    <label>储罐</label>
    <description>存放流体。四面可接管道（管道铺在端口朝向的邻格）。</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <!-- Battery -->
      <texPath>Things/Building/Power/Battery</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>50</Steel>
    </costList>
    <building>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="RimPipe.CompProperties_PipeNetworkMember">
        <defaultMaxFlowRate>10</defaultMaxFlowRate>
        <!-- 产品储罐保温较高，方便和 Dev 罐对比 -->
        <insulation>0.7</insulation>
        <maxAmbientHeatRate>10</maxAmbientHeatRate>
        <containers>
          <li>
            <capacity>100</capacity>
            <fluidDefName>RimPipe_Fluid_TestWater</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
        </containers>
        <ports>
          <li>
            <localRot>North</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>South</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>West</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>East</localRot>
            <containerIndex>0</containerIndex>
          </li>
        </ports>
      </li>
      <li Class="RimPipe.CompProperties_PipeBreachable" />
    </comps>
    <placeWorkers>
      <li>RimPipe.PlaceWorker_RimPipeAppliance</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <designationCategory>RimPipe</designationCategory>
    <uiOrder>100</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- 三口布局与 Dev 三通一致（北/西/东，无南），方便回归。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>RimPipe_TeeJunction</defName>
    <label>三通管</label>
    <description>三通接头。北、西、东三口（无南口）。</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <!-- MoisturePump（中文常称排水泵/抽湿机） -->
      <texPath>Things/Building/Misc/MoisturePump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>15</Steel>
    </costList>
    <building>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="RimPipe.CompProperties_PipeNetworkMember">
        <defaultMaxFlowRate>10</defaultMaxFlowRate>
        <containers>
          <li>
            <capacity>50</capacity>
            <fluidDefName>RimPipe_Fluid_TestWater</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
        </containers>
        <ports>
          <li>
            <localRot>North</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>West</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>East</localRot>
            <containerIndex>0</containerIndex>
          </li>
        </ports>
      </li>
    </comps>
    <placeWorkers>
      <li>RimPipe.PlaceWorker_RimPipeAppliance</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <designationCategory>RimPipe</designationCategory>
    <uiOrder>110</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RimPipe_Pipe</defName>
    <label>管道</label>
    <description>连接设备用的管道格，本身不存流体。</description>
    <thingClass>RimPipe.Building_PipeCell</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Custom1</li>
      </linkFlags>
      <damageData>
        <rect>(0,0.35,1,0.3)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Linked/PowerConduit_MenuIcon</uiIconPath>
    <uiIconScale>0.7</uiIconScale>
    <building>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath>
      </blueprintGraphicData>
      <canConstructInCorner>true</canConstructInCorner>
    </building>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Conduits</altitudeLayer>
    <passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>35</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <drawStyleCategory>Conduits</drawStyleCategory>
    <costList>
      <Steel>1</Steel>
    </costList>
    <comps>
      <li Class="RimPipe.CompProperties_PipeCell" />
    </comps>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <clearBuildingArea>false</clearBuildingArea>
    <placeWorkers>
      <li>RimPipe.PlaceWorker_RimPipeCell</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <designationCategory>RimPipe</designationCategory>
    <uiOrder>120</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- 阀门：两岸小腔 + 内部通路；开关只改流量，不拆连接。独立管件。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>RimPipe_Valve</defName>
    <label>阀门</label>
    <description>西东两口。关闭后这里不再过流，但连接关系还在。</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <!-- PowerSwitch -->
      <texPath>Things/Building/Power/PowerSwitch</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>25</Steel>
    </costList>
    <building>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="RimPipe.CompProperties_PipeNetworkMember">
        <defaultMaxFlowRate>10</defaultMaxFlowRate>
        <containers>
          <li>
            <capacity>10</capacity>
            <fluidDefName>RimPipe_Fluid_TestWater</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
          <li>
            <capacity>10</capacity>
            <fluidDefName>RimPipe_Fluid_TestWater</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
        </containers>
        <ports>
          <li>
            <localRot>West</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>East</localRot>
            <containerIndex>1</containerIndex>
          </li>
        </ports>
      </li>
      <li Class="RimPipe.CompProperties_PipeValve">
        <baseMaxFlowRate>10</baseMaxFlowRate>
        <containerIndexA>0</containerIndexA>
        <containerIndexB>1</containerIndexB>
      </li>
    </comps>
    <placeWorkers>
      <li>RimPipe.PlaceWorker_RimPipeAppliance</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <designationCategory>RimPipe</designationCategory>
    <uiOrder>130</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- 泵：两岸小腔 + 强制单向内部通路；开且有电才满流量。独立管件。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>RimPipe_Pump</defName>
    <label>泵</label>
    <description>西口吸入、东口排出。有电且开启时强制单向满流量；关闭或断电则停，连接关系还在。</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <!-- MoisturePump：语义贴近泵；三通亦借用此贴图（阶段三暂可重复） -->
      <texPath>Things/Building/Misc/MoisturePump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="RimPipe.CompProperties_PipeNetworkMember">
        <defaultMaxFlowRate>10</defaultMaxFlowRate>
        <containers>
          <li>
            <capacity>10</capacity>
            <fluidDefName>RimPipe_Fluid_TestWater</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
          <li>
            <capacity>10</capacity>
            <fluidDefName>RimPipe_Fluid_TestWater</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
        </containers>
        <ports>
          <li>
            <localRot>West</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>East</localRot>
            <containerIndex>1</containerIndex>
          </li>
        </ports>
      </li>
      <li Class="RimPipe.CompProperties_PipePump">
        <baseMaxFlowRate>10</baseMaxFlowRate>
        <containerIndexA>0</containerIndexA>
        <containerIndexB>1</containerIndexB>
        <forcedFromA>true</forcedFromA>
      </li>
    </comps>
    <placeWorkers>
      <li>RimPipe.PlaceWorker_RimPipeAppliance</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <designationCategory>RimPipe</designationCategory>
    <uiOrder>140</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- 换热器：两岸腔体导热；开关只改换热，不拆连接。无电力。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>RimPipe_HeatExchanger</defName>
    <label>换热器</label>
    <description>西东两腔。开启时两边换热均温，不搬流体；关闭则停止换热，连接关系还在。</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <!-- Cooler：语义贴近换热 -->
      <texPath>Things/Building/Misc/TempControl/Cooler</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="RimPipe.CompProperties_PipeNetworkMember">
        <defaultMaxFlowRate>10</defaultMaxFlowRate>
        <containers>
          <li>
            <capacity>50</capacity>
            <fluidDefName>RimPipe_Fluid_TestWater</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
          <li>
            <capacity>50</capacity>
            <fluidDefName>RimPipe_Fluid_TestWater</fluidDefName>
            <initialAmount>0</initialAmount>
          </li>
        </containers>
        <ports>
          <li>
            <localRot>West</localRot>
            <containerIndex>0</containerIndex>
          </li>
          <li>
            <localRot>East</localRot>
            <containerIndex>1</containerIndex>
          </li>
        </ports>
      </li>
      <li Class="RimPipe.CompProperties_PipeHeatExchanger">
        <baseMaxHeatRate>50</baseMaxHeatRate>
        <containerIndexA>0</containerIndexA>
        <containerIndexB>1</containerIndexB>
      </li>
    </comps>
    <placeWorkers>
      <li>RimPipe.PlaceWorker_RimPipeAppliance</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <designationCategory>RimPipe</designationCategory>
    <uiOrder>150</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

</Defs>
